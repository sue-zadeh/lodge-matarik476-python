
-- -----------------------------------------------------
-- Table lodge
-- -----------------------------------------------------

CREATE TABLE IF NOT EXISTS users (
    user_id SERIAL PRIMARY KEY,
    username VARCHAR(80) UNIQUE NOT NULL CHECK (char_length(username) >= 5),
    first_name VARCHAR(80) NOT NULL,
    last_name VARCHAR(80) NOT NULL,
    email VARCHAR(190) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    phone VARCHAR(40) CHECK (phone ~ '^[0-9+ ]*$'),
    address VARCHAR(255) NOT NULL,
    birth_date DATE NOT NULL,
    profile_image VARCHAR(255),
    role VARCHAR(20) NOT NULL DEFAULT 'member' CHECK (role IN ('member','admin')),
    is_active BOOLEAN NOT NULL DEFAULT FALSE,

    -- Forgot password
    password_reset_token VARCHAR(255),
    password_reset_token_expiry TIMESTAMPTZ,

    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS admin_messages (
    id        SERIAL PRIMARY KEY,
    note      TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Files that admins send to members
CREATE TABLE IF NOT EXISTS files (
    file_id SERIAL PRIMARY KEY,
    subject VARCHAR(255) NOT NULL,
    description TEXT,
    filename VARCHAR(255) NOT NULL,
    is_admin_only BOOLEAN NOT NULL DEFAULT FALSE,
    uploaded_by INT NOT NULL REFERENCES users(user_id),
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Which member has "read" which file (for new-files notifications)
CREATE TABLE IF NOT EXISTS file_reads (
    user_id INTEGER NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
    file_id INTEGER NOT NULL REFERENCES files(file_id) ON DELETE CASCADE,
    read_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    PRIMARY KEY (user_id, file_id)
);

CREATE TABLE IF NOT EXISTS contact_messages (
    id SERIAL PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    email VARCHAR(190) NOT NULL,
    phone VARCHAR(50),
    message TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);


-- EVENTS (admin creates, members view)
CREATE TABLE IF NOT EXISTS events (
  event_id SERIAL PRIMARY KEY,
  title VARCHAR(255) NOT NULL,
  description TEXT,
  event_date DATE NOT NULL,
  start_time TIME NOT NULL,
  end_time TIME,
  location VARCHAR(255),
  is_admin_only BOOLEAN NOT NULL DEFAULT FALSE,
  is_pinned BOOLEAN NOT NULL DEFAULT FALSE,
  created_by INT REFERENCES users(user_id),
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- tracks “NEW” badge per member
CREATE TABLE IF NOT EXISTS event_reads (
  event_id INT NOT NULL REFERENCES events(event_id) ON DELETE CASCADE,
  user_id INT NOT NULL REFERENCES users(user_id) ON DELETE CASCADE,
  seen_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  PRIMARY KEY (event_id, user_id)
);

-- Idempotent hardening for databases created by an older revision.
ALTER TABLE users ALTER COLUMN is_active SET DEFAULT FALSE;
CREATE UNIQUE INDEX IF NOT EXISTS users_password_reset_token_unique
    ON users(password_reset_token) WHERE password_reset_token IS NOT NULL;
CREATE INDEX IF NOT EXISTS users_active_username_idx
    ON users(LOWER(username), is_active);
CREATE INDEX IF NOT EXISTS files_member_visibility_idx
    ON files(is_admin_only, created_at DESC);
CREATE INDEX IF NOT EXISTS events_member_visibility_idx
    ON events(is_admin_only, event_date, start_time);
CREATE INDEX IF NOT EXISTS contact_messages_created_at_idx
    ON contact_messages(created_at);
